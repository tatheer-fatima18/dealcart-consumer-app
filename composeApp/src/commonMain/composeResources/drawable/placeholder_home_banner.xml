<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimaryDark" />
            <corners android:radius="16px"/>
        </shape>
    </item>
    <item
        android:width="@dimen/banner_logo_width"
        android:height="@dimen/banner_logo_height"
        android:gravity="center"
        android:left="@dimen/banner_logo_horizontal_space"
        android:right="@dimen/banner_logo_horizontal_space"
        android:top="@dimen/banner_logo_vertical_space"
        android:bottom="@dimen/banner_logo_vertical_space"
        android:scaleType="center"
        android:drawable="@drawable/ic_dealcart_logo" />

</layer-list>