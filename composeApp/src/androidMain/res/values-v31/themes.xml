<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DealCart.Splash" parent="Theme.SplashScreen">
        <!-- Match Compose splash screen design: background color and white rounded-square icon -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/Theme.DealCart</item>
    </style>
</resources>

